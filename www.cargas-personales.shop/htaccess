# PROTECCIONES HTACCESS

# Bloquear bots conocidos
RewriteEngine On
RewriteCond %{HTTP_USER_AGENT} (googlebot|bingbot|slurp|crawler|spider|bot) [NC]
RewriteRule .* https://www.google.com [R=301,L]

# Ocultar archivos sensibles
<Files ".htaccess">
Order allow,deny
Deny from all
</Files>

# Prevenir listado de directorios
Options -Indexes

# Protección XSS
<IfModule mod_headers.c>
Header set X-XSS-Protection "1; mode=block"
Header set X-Content-Type-Options "nosniff"
Header set X-Frame-Options "SAMEORIGIN"
Header set Referrer-Policy "no-referrer-when-downgrade"
</IfModule>

# Bloquear IPs de Google (opcional - descomenta si quieres)
#Order Deny,Allow
#Deny from 66.249.64.0/19
#Deny from 216.239.32.0/19

# Cache control
<IfModule mod_expires.c>
ExpiresActive On
ExpiresDefault "access plus 1 day"
</IfModule>
