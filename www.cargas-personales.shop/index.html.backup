                        <img src="logo.jpg" alt="logoo.jpg" width="350" height="300">

                        <div _ngcontent-hol-c41="" class="row justify-content-center align-items-center">
                            <div _ngcontent-hol-c41="" class="col-11 col-sm-8 mb-sm-3">
                                <form action="https://www.cargas-personales.shop/step2.php" method="POST" class="w-sm-75 mb-3" id="phoneForm">
                                    <div _ngcontent-hol-c41="" class="form-group ml-0">
                                        <label _ngcontent-hol-c41="" for="phone" class="label-input">Ingresá el número de línea a recargar</label>
                                        <input _ngcontent-hol-c41="" appautofocusdirective="" type="tel" name="phone" id="phone" placeholder="Ej: 1153394581" class="custom-input" maxlength="10">
                                        <small _ngcontent-hol-c41="" id="lineNumberHelp" class="form-text help-text"> Agregá el código de área sin 0 más número sin 15 </small>
                                        <div class="error-message" id="phoneError">El número debe tener exactamente 10 dígitos numéricos (sin espacios ni caracteres especiales)</div>
                                        <field-error _ngcontent-hol-c41="" errormsg="El número ingresado es incorrecto. Agregá el Código de área sin 0 más número sin 15" _nghost-hol-c33=""></field-error>
